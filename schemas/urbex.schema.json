{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urbforge.github.io/urbex/schemas/urbex.schema.json",
  "title": "Urbex app manifest",
  "description": "Schema for urbex.yaml, the per-app manifest declaring an app's infrastructure needs. See docs/reference/manifest.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "project"],
  "anyOf": [
    { "required": ["frontend"] },
    { "required": ["services"] }
  ],
  "properties": {
    "apiVersion": {
      "const": "urbex/v1"
    },
    "project": {
      "type": "string",
      "description": "Unique project name on the platform.",
      "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
    },
    "environments": {
      "type": "array",
      "description": "The stack's environments: [staging, prod] (the default), or [prod] for a stack that runs only one - release and promote then don't apply. See docs/decisions/0028-application-model.md.",
      "items": { "enum": ["staging", "prod"] },
      "minItems": 1,
      "uniqueItems": true,
      "contains": { "const": "prod" },
      "default": ["staging", "prod"]
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "provider", "buildCommand", "outputDir"],
      "properties": {
        "type": { "enum": ["web", "mobile"] },
        "provider": { "enum": ["cloudflare-pages", "firebase"] },
        "buildCommand": { "type": "string", "minLength": 1 },
        "outputDir": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "web" } } },
          "then": { "properties": { "provider": { "const": "cloudflare-pages" } } }
        },
        {
          "if": { "properties": { "type": { "const": "mobile" } } },
          "then": { "properties": { "provider": { "const": "firebase" } } }
        }
      ]
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/service" }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subdomain"],
      "properties": {
        "subdomain": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,61}[a-z0-9]$"
        }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metrics": { "type": "boolean", "default": true },
        "logs": { "type": "boolean", "default": true }
      }
    },
    "email": {
      "type": "object",
      "description": "Transactional email configuration. The provider API key is never set here — it is managed as a secret (see docs/decisions/0011-secrets-sops-age.md).",
      "additionalProperties": false,
      "required": ["provider", "fromAddress"],
      "properties": {
        "provider": {
          "enum": ["brevo"],
          "description": "Managed transactional email provider. Only 'brevo' is supported in v1; more providers will be added over time (see docs/decisions/0015-transactional-email-brevo.md)."
        },
        "fromAddress": {
          "type": "string",
          "format": "email"
        },
        "fromName": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "oneOf": [
        { "required": ["runtime", "port"], "not": { "anyOf": [{ "required": ["image"] }, { "required": ["version"] }] } },
        { "required": ["image", "version"], "not": { "required": ["runtime"] } }
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$"
        },
        "runtime": { "enum": ["java", "python", "go", "docker"] },
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "An application from a published image, pulled as it is (e.g. 'postgres', 'ghcr.io/immich-app/postgres'). Exclusive with runtime. See docs/decisions/0028-application-model.md."
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "description": "The image's tag (e.g. \"17\" or \"17.6\"); each environment runs the digest it resolved to. Required with image."
        },
        "provides": {
          "enum": ["postgres"],
          "description": "The interface this application implements, so that urbex configures it and passes its connection to the applications that use it. See docs/decisions/0030-postgresql-application.md."
        },
        "uses": {
          "type": "array",
          "description": "Names of the applications of the stack this one needs: deployed first, and their connection passed (DATABASE_URL and PG* for a postgres provider).",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$" },
          "uniqueItems": true
        },
        "volumes": {
          "type": "array",
          "description": "What the application keeps: named volumes (name, size), data kept across redeploys, updates and the LXC being changed in place, deleted only by destroy --delete-data; and shares (share, readOnly), folders the operator declares in urbex.platform.yaml under storage.shares.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$" },
              "share": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,38}[a-z0-9]$" },
              "path": { "type": "string", "pattern": "^/." },
              "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$", "default": "10Gi" },
              "readOnly": { "type": "boolean", "default": false }
            },
            "oneOf": [
              { "required": ["name"], "not": { "anyOf": [{ "required": ["share"] }, { "required": ["readOnly"] }] } },
              { "required": ["share"], "not": { "anyOf": [{ "required": ["name"] }, { "required": ["size"] }] } }
            ]
          }
        },
        "dockerfile": {
          "type": "string",
          "description": "Required when runtime is 'docker'. Path to the Dockerfile, relative to the repo root."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "healthcheck": {
          "type": "string",
          "description": "HTTP path probed (GET, inside the container) to tell whether the service is healthy. No healthcheck when omitted."
        },
        "public": {
          "type": "boolean",
          "default": false,
          "description": "Publish the service on the internet, at its environment's hostname, through the platform's Cloudflare Tunnel. Needs Cloudflare configured in urbex.platform.yaml."
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": { "type": "integer", "minimum": 1, "default": 1 },
            "memory": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$", "default": "1Gi" },
            "disk": { "type": "string", "pattern": "^[0-9]+(Mi|Gi)$", "default": "5Gi" }
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "staging": { "type": "object", "additionalProperties": { "type": "string" } },
            "prod": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keycloak": { "type": "boolean", "default": false },
            "roles": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        }
      },
      "allOf": [
        {
          "if": { "required": ["runtime"], "properties": { "runtime": { "const": "docker" } } },
          "then": { "required": ["dockerfile"] }
        },
        {
          "if": { "required": ["provides"], "properties": { "provides": { "const": "postgres" } } },
          "then": {
            "required": ["volumes"],
            "properties": {
              "volumes": { "minItems": 1, "maxItems": 1, "items": { "required": ["name"] } },
              "public": { "const": false }
            },
            "not": { "anyOf": [{ "required": ["port"] }, { "required": ["healthcheck"] }] }
          }
        }
      ]
    }
  }
}
