#!/bin/bash
# What Claude Code runs as git in claude.tape: git through
# demo-env.sh's demo_hide: example.com for the platform's domain; a
# remote shows no credentials or LAN address.
here=$(cd "$(dirname "$0")" && pwd)
PATH=${PATH//$here:/}
DEMO_PLAIN=1
# shellcheck source=../demo-env.sh
source "$here/../demo-env.sh"
git "$@" 2>&1 | demo_hide
exit "${PIPESTATUS[0]}"
