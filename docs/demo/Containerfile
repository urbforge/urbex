# The image that records the README's GIF: the operator image of
# urbex-cli (tools/operator, with urbex and its tools) plus VHS, the
# terminal it records in (ttyd), Chromium it drives, and ffmpeg.
ARG BASE=urbex-operator
FROM ${BASE}
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg chromium fonts-jetbrains-mono curl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ARG TTYD_VERSION=1.7.7
RUN curl -fsSL -o /usr/local/bin/ttyd "https://github.com/tsl0922/ttyd/releases/download/${TTYD_VERSION}/ttyd.x86_64" \
 && chmod +x /usr/local/bin/ttyd
ARG VHS_VERSION=0.12.1
RUN curl -fsSL "https://github.com/charmbracelet/vhs/releases/download/v${VHS_VERSION}/vhs_${VHS_VERSION}_Linux_x86_64.tar.gz" \
    | tar -xz -C /usr/local/bin --strip-components=1 --wildcards '*/vhs'
# Chromium can't use its sandbox in a rootless container.
ENV VHS_NO_SANDBOX=true
